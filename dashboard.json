                        "dataset": "Dynamics",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "\r\nSELECT \r\n    \"Accel X (m/s²)\",\r\n    \"Accel Y (m/s²)\",\r\n    \"Accel Z (m/s²)\",\r\n    \"Gyro X (rad/s)\",\r\n    \"Gyro Y (rad/s)\",\r\n    \"Gyro Z (rad/s)\"\r\nFROM (\r\n    SELECT \r\n        id,\r\n        ax AS \"Accel X (m/s²)\",\r\n        ay AS \"Accel Y (m/s²)\",\r\n        az AS \"Accel Z (m/s²)\",\r\n        gx AS \"Gyro X (rad/s)\",\r\n        gy AS \"Gyro Y (rad/s)\",\r\n        gz AS \"Gyro Z (rad/s)\"\r\n    FROM sensor_telemetry\r\n    ORDER BY id DESC\r\n    LIMIT 20\r\n) sub\r\nORDER BY id ASC",
                        "sql": {
